{
  "expo": {
    "name": "liwa",
    "slug": "liwa",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/liwa_color.png",
    "scheme": "liwa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/liwa_color.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/liwa_color.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jonathan1173.liwa"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/liwa_color.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "30d5e9a5-e1e2-474d-b779-2096ebf39c05"
      }
    }
  }
}
